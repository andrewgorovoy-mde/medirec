MEDPLUM_BASE_URL=https://api.medplum.com
MEDPLUM_CLIENT_ID=

# Capture layer — reconciliation session
# Set to "false" once the three bots below are deployed and configured.
MEDPLUM_MOCK_BOTS=true
MEDPLUM_BOT_SESSION_START=
MEDPLUM_BOT_CHECK_MED=
MEDPLUM_BOT_SESSION_SUMMARY=

# Server-only secrets for api/extract — set these in .env (gitignored), never here.
# GEMINI_API_KEY=
# MOSS_PROJECT_ID=
# MOSS_PROJECT_KEY=

# Server-only Deepgram settings for /api/deepgram/token.
# DEEPGRAM_API_KEY=
DEEPGRAM_TOKEN_TTL_SECONDS=30
# DEEPGRAM_AUTH_GRANT_URL=https://api.deepgram.com/v1/auth/grant

# Server-only medication vision service settings for /api/medications/identify.
# If MEDICATION_VISION_API_URL is unset, the endpoint falls back to the existing local
# /api/extract implementation when an inline base64 image is provided.
# MEDICATION_VISION_API_URL=
# MEDICATION_VISION_API_KEY=
MEDICATION_VISION_TIMEOUT_MS=10000

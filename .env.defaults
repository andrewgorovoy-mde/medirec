MEDPLUM_BASE_URL=https://api.medplum.com
MEDPLUM_CLIENT_ID=

# Capture layer — reconciliation session
# Set to "false" once the three bots below are deployed and configured.
MEDPLUM_MOCK_BOTS=true
MEDPLUM_BOT_SESSION_START=
MEDPLUM_BOT_CHECK_MED=
MEDPLUM_BOT_SESSION_SUMMARY=

# Server-only secrets for api/extract — set these in .env (gitignored), never here.
# GEMINI_API_KEY=
# MOSS_PROJECT_ID=
# MOSS_PROJECT_KEY=

# Server-only credentials for api/survey (patient portal DOB verification) — set these in
# .env (gitignored), never here.
# SURVEY_CLIENT_ID=
# SURVEY_CLIENT_SECRET=

# Server-only Deepgram credential for api/deepgram/token — set this in .env (gitignored), never
# here.
# DEEPGRAM_API_KEY=
